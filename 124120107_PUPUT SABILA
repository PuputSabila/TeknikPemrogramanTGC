from abc import ABC, abstractmethod

# Membuat class abstrak
class Survey(ABC):
    def __init__(self, lokasi):
        self.lokasi = lokasi

    @abstractmethod
    def processing(self):
        pass


# Turunan untuk SeismicSurvey
class SeismicSurvey(Survey):
    def processing(self):
        return f"Seismic processing di {self.lokasi}: Melakukan filtering data seismik."


# Turunan untuk GravitySurvey
class GravitySurvey(Survey):
    def processing(self):
        return f"Gravity processing di {self.lokasi}: Melakukan upward continuation."


# Turunan untuk MagnetikSurvey
class MagnetikSurvey(Survey):
    def processing(self):
        return f"Magnetik processing di {self.lokasi}: Melakukan anomaly mapping."


# Contoh penggunaan
if __name__ == "__main__":
    # Membuat objek-objek survey
    survei_list = [
        SeismicSurvey("Sumatera"),
        GravitySurvey("Kalimantan"),
        MagnetikSurvey("Papua")
    ]

    # Iterasi dan panggil processing()
    for survei in survei_list:
        print(survei.processing())

